      "item": [
        {
          "name": "TC_API_01: Lấy danh mục 63 Tỉnh/Thành phố",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shipping/provinces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shipping",
                "provinces"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is array of provinces', function () { var data = pm.response.json(); pm.expect(data).to.be.an('array'); pm.expect(data.length).to.be.above(60); });"
